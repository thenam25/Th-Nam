# ═══════════════════════════════════════════════════════════════════════
# NÔNG CƠ MACHINERY — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real values.
# All variables below are REQUIRED for production/Vercel deployment
# unless marked as (Optional).

# ── AI / Gemini (Optional) ────────────────────────────────────────────────
# Required for AI-powered PPTX catalog import. Without this, imports
# fall back to basic XML text extraction (less accurate).
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── Admin Security ──────────────────────────────────────────────────────
# Secret key protecting admin API endpoints (POST/PUT/DELETE).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY="YOUR_API_SECRET_KEY"

# Password for admin panel login.
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# ── Supabase (Data Persistence + Image Storage) ──────────────────────────
# REQUIRED on Vercel! Without this, ALL data is lost on cold starts.
# Free tier: 500MB PostgreSQL + 1GB file storage + 50K MAU.
# Sign up at https://supabase.com → create project → Settings → API
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ⚠️ After creating your Supabase project, run this SQL to enable cloud sync:
#
#   CREATE TABLE IF NOT EXISTS app_state (
#     id INTEGER PRIMARY KEY DEFAULT 1 CHECK (id = 1),
#     json_data JSONB NOT NULL DEFAULT '{}'::jsonb,
#     updated_at TIMESTAMPTZ DEFAULT NOW()
#   );
#   INSERT INTO app_state (id, json_data) VALUES (1, '{}'::jsonb)
#   ON CONFLICT (id) DO NOTHING;
#   ALTER TABLE app_state ENABLE ROW LEVEL SECURITY;
#   CREATE POLICY "anon_read"   ON app_state FOR SELECT USING (true);
#   CREATE POLICY "anon_insert"  ON app_state FOR INSERT WITH CHECK (id = 1);
#   CREATE POLICY "anon_update"  ON app_state FOR UPDATE USING (id = 1);

# ── Cloudinary (Image CDN — Recommended for 6000+ ảnh) ───────────────────
# Free tier: 25GB storage + 25GB bandwidth/month. Auto-optimize + CDN.
# Sign up at https://cloudinary.com → Dashboard → API Keys
# Without this, images fall back to Supabase Storage (1GB free).
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# ── Legacy Firestore (Deprecated) ────────────────────────────────────────
# No longer needed. Use Supabase (above) instead for data persistence.
# Kept here for backward compatibility if you were using Firestore before.
# FIRESTORE_BASE_URL="..."
# FIRESTORE_API_KEY="..."

# ── App URL (Optional) ──────────────────────────────────────────────────
# The public URL where this app is hosted (e.g. https://your-app.vercel.app).
# Used for self-referential links.
# APP_URL="https://YOUR_APP.vercel.app"
